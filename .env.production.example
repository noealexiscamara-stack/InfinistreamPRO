# Copy to .env.production on the VPS and fill in real values — this file
# only holds placeholders and is safe to commit. .env.production itself is
# gitignored; never commit it (see docs/GUIDE_VPS.md).
#
# Generate JWT_SECRET and ENCRYPTION_KEY with:
#   openssl rand -hex 32
# (run it twice — each secret must be unique, and generated ON the VPS, not
# reused from the .env.example dev placeholders.)

DB_USERNAME=infiny_stream
DB_PASSWORD=replace-with-a-strong-random-password
DB_NAME=infiny_stream

JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

ENCRYPTION_KEY=replace-with-a-different-output-of-openssl-rand-hex-32

# --- Pricing (product rule #38: source of truth for the mobile app — never
# hardcoded client-side) ---
PREMIUM_BASE_PRICE=5
PREMIUM_BASE_CURRENCY=EUR
TRIAL_DAYS=30
DEVICE_LIMIT=2

# --- Payment providers — leave blank until real merchant credentials are
# available (see docs/LIMITATIONS.md #4); the corresponding provider returns
# 503 until configured, it never silently pretends to succeed. ---
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
HOLOPAY_API_KEY=
