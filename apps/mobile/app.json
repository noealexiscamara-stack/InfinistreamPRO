{
  "expo": {
    "name": "Infiny Stream",
    "slug": "infiny-stream",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "infinystream",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.infinystream.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.infinystream.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-sqlite",
      "expo-video",
      "./plugins/withAndroidTv",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "infinyStream": {
        "trialDays": 30,
        "defaultDeviceLimit": 2
      },
      "router": {},
      "eas": {
        "projectId": "697ff48d-ee5a-4de6-88ed-d49de57f6fcf"
      }
    },
    "owner": "mrnac99"
  }
}
