# Copy to .env for local development.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=infiny_stream
DB_PASSWORD=change-me
DB_NAME=infiny_stream
DB_SYNCHRONIZE=true

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Security ---
# Used to encrypt sensitive playlist credentials (Xtream passwords) at rest.
ENCRYPTION_KEY=change-me-in-production

# --- Pricing (rule #38/#39: never hardcoded client-side, this is the source of truth) ---
PREMIUM_BASE_PRICE=5
PREMIUM_BASE_CURRENCY=EUR
TRIAL_DAYS=30
DEVICE_LIMIT=2

# --- Payment providers (rule #40) ---
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
HOLOPAY_API_KEY=
