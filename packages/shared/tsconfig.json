{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020"],
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@infiny-stream/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src"]
}
